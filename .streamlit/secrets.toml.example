# Copie este archivo como .streamlit/secrets.toml (no subir a git)

[lexivox_auth]
# admin_username = "admin"
# admin_password = "tu_contraseña_segura"
# admin_nombre = "Administrador del despacho"
# disabled = false

[google_oauth]
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# Tipo: "Aplicación web". URI de redirección autorizada = redirect_uri (exacta).
# client_id = "123456789-xxxx.apps.googleusercontent.com"
# client_secret = "GOCSPX-xxxxxxxx"
# redirect_uri = "http://localhost:8501"
# Debe coincidir EXACTAMENTE con la URI autorizada en Google Cloud (sin barra final).

[openai]
# OPENAI_API_KEY = "sk-..."
# ASSISTANT_ID = "asst_..."
