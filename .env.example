# Copie este archivo como .env (no subir a git).
# Streamlit lee principalmente .streamlit/secrets.toml; estas variables
# complementan la configuración en despliegues Docker/servidor.

# --- Autenticación del despacho ---
# LEXIVOX_AUTH_DISABLED=0
# LEXIVOX_ADMIN_USERNAME=admin
# LEXIVOX_ADMIN_PASSWORD=cambie_esta_contraseña
# LEXIVOX_ADMIN_NOMBRE=Administrador

# --- Google OAuth ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501
# GOOGLE_OAUTH_STATE_SECRET=generar_cadena_larga_aleatoria

# --- OpenAI (Experto en expediente electrónico) ---
# OPENAI_API_KEY=sk-...
# OPENAI_ASSISTANT_ID=asst_...

# --- Logging ---
# GARCIABERMEO_LOG_LEVEL=INFO
